# Base URL of the Django API (no trailing slash needed).
VITE_API_URL=http://127.0.0.1:8000/api

# OAuth client IDs. A provider's button only appears when its client ID is set.
VITE_GOOGLE_CLIENT_ID=
VITE_MICROSOFT_CLIENT_ID=
VITE_GITHUB_CLIENT_ID=

# Set to 1 to run the UI against built-in fixtures instead of the backend.
VITE_MOCK=0
